generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model PC {
  id         Int     @id @default(autoincrement())
  pcId       String  @unique
  macAddress String
  connected  Boolean @default(false)
}

model Session {

  id             Int      @id @default(autoincrement())

  pcId           String

  startTime      DateTime

  endTime        DateTime?

  plannedMinutes Int

  actualMinutes  Int?

  gamingCharge   Float    @default(0)

  foodGrossTotal      Float    @default(0)
  foodCommissionTotal Float    @default(0)
  foodNetTotal        Float    @default(0)

  totalAmount    Float    @default(0)

  paidAt         DateTime?

  status         String   @default("ACTIVE")

  foodSales      FoodSale[]
}

model Setting {

  id Int @id @default(1)

  cafeName String @default("CafeOps")

  billingType String @default("PER_MINUTE")

  gamingRate Float @default(2)

  currency String @default("INR")

}

model FoodSettings {
  id               Int    @id @default(1)

  businessModel    String @default("IN_HOUSE")
  commissionType   String @default("PERCENTAGE")
  commissionValue  Float  @default(0)
}

model FoodSale {
  id               Int      @id @default(autoincrement())

  sessionId        Int
  itemName         String
  unitPrice        Float
  quantity         Int      @default(1)

  grossAmount      Float
  commissionType   String
  commissionValue  Float
  commissionAmount Float
  netAmount        Float

  createdAt        DateTime @default(now())

  session          Session  @relation(fields: [sessionId], references: [id])
}

model OwnerAuth {
  id           Int      @id @default(1)
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}