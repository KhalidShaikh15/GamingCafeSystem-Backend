generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model PC {
  id         Int     @id @default(autoincrement())
  pcId       String  @unique
  macAddress String
  connected  Boolean @default(false)
}

model Session {

  id             Int      @id @default(autoincrement())

  pcId           String

  startTime      DateTime

  endTime        DateTime?

  plannedMinutes Int

  actualMinutes  Int?

  gamingCharge   Float    @default(0)

  status String @default("ACTIVE")

} 